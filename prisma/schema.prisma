generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type Contact {
  email     String
  publicKey String
  addedAt   DateTime @default(now())
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  email           String   @unique
  firstName       String
  lastName        String
  birthDate       DateTime?
  phone           String?
  address         String?

  passwordHash    String
  passwordSalt    String

  otp             String?
  otpCreatedAt    DateTime?
  otpExpiresAt    DateTime?

  failedLoginAttempts Int       @default(0)
  lastFailedLogin     DateTime?
  accountLockedUntil  DateTime?

  role            String   @default("USER")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ✅ One-to-one: user chỉ có 1 rsaKey
  rsaKey          RSAKey?  @relation("UserRSAKey")

  // Hash của mã khôi phục, có thể null, và phải là duy nhất
  recoveryCodeHash String?

  contacts        Contact[]

  @@map("users")
}

model RSAKey {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId

  publicKey           String
  encryptedPrivateKey String
  passphraseSalt      String
  iv                  String

  createdAt           DateTime @default(now())
  expiresAt           DateTime

  userId              String   @unique @db.ObjectId
  user                User     @relation("UserRSAKey", fields: [userId], references: [id])

  @@map("rsa_keys")
}

model LogActivity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  timestamp   DateTime @default(now())
  userId      String?  @db.ObjectId // Optional, if log is not tied to a specific user
  email       String? // Optional, for easier lookup
  action      String
  status      String // e.g., "SUCCESS", "FAILED"
  details     String? // Optional, more detailed message

  @@map("log_activities")
}
