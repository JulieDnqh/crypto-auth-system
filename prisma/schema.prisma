generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  email           String   @unique
  firstName       String
  lastName        String
  birthDate       DateTime?
  phone           String?
  address         String?

  passwordHash    String
  passwordSalt    String

  otp             String?
  otpCreatedAt    DateTime?
  otpExpiresAt    DateTime?

  role            String   @default("USER")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ✅ One-to-one: user chỉ có 1 rsaKey
  rsaKey          RSAKey?  @relation("UserRSAKey")

  @@map("users")
}

model RSAKey {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId

  publicKey           String
  encryptedPrivateKey String
  passphraseSalt      String
  iv                  String

  createdAt           DateTime @default(now())
  expiresAt           DateTime

  userId              String   @unique @db.ObjectId
  user                User     @relation("UserRSAKey", fields: [userId], references: [id])

  @@map("rsa_keys")
}
